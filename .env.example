# Astra NDR - copy to .env and adjust. NEVER commit real secrets.

# Postgres
POSTGRES_PASSWORD=astra_dev_password

# ClickHouse (telemetry tier, Phase 2+)
CLICKHOUSE_PASSWORD=astra_dev_password

# Shared secret sensors present when enrolling / ingesting.
# Generate a strong value in production: `openssl rand -hex 32`
ASTRA_SENSOR_TOKEN=dev-sensor-token-change-me
